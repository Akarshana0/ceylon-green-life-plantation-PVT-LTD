// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model for authentication and RBAC
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  role          String    @default("VIEWER") // VIEWER or ADMIN
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Core Employee Data based on the provided Excel structure
model Employee {
  id              String    @id @default(cuid())
  
  // Basic Info
  employeeNo      String?   @unique
  epfNo           String?
  fullName        String
  nameWithInitial String?
  gender          String?
  dateOfBirth     DateTime?
  address         String?
  idNumber        String?   @unique // NIC or Passport
  phoneNumber     String?
  email           String?   @unique
  
  // Employment Info
  joinDate        DateTime?
  designation     String?
  department      String?
  branch          String?
  reportingLine   String?
  branchManager   String?
  regionalManager String?
  zonalManager    String?
  assistantGeneralManager String?
  generalManager  String?
  provincialHead  String?

  // Emergency/Personal
  policeStation   String?
  gramaNiladhari  String?
  guardianName    String?
  guardianContactNo String?

  // Bank Details (Sensitive - Requires Admin Elevation)
  bankName        String?
  bankBranch      String?
  accountNumber   String?

  // History / Status
  promotionDate1  DateTime?
  promotedDesignation1 String?
  promotionDate2  DateTime?
  promotedDesignation2 String?
  dateOfResignation DateTime?
  dateOfTermination DateTime?
  dummyCode       String?

  // Photo
  profilePhotoUri String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
