rules_version = '2';

// ============================================================================
// Ceylon Green Life Plantation — Storage Security Rules
//
// HOW TO INSTALL:
//   Firebase Console → Storage → Rules tab → paste this file's contents
//   over the existing rules → Publish.
//
// WHAT THIS ENFORCES:
//   - Only signed-in users can view or upload employee photos.
//   - Uploads must be images, under 3MB, stored under /employees/{empId}/...
//   - Everything else in the bucket is locked down.
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    match /employees/{empId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 3 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
